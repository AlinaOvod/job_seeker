{
  "filters": {
    "includeTitle": [
      "full stack",
      "full-stack",
      "fullstack",
      "frontend",
      "front-end",
      "front end",
      "react",
      "next.js",
      "nextjs",
      "node.js",
      "nodejs",
      "typescript",
      "javascript"
    ],
    "excludeTitle": [
      "senior",
