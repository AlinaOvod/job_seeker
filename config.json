    "excludeText": [],
    "locations": ["remote", "віддалено", "удаленно", "kyiv", "kiev", "київ"],
    "maxAgeHours": 72
  },
  "sources": [
    {
      "type": "rss",
      "name": "Djinni",
      "url": "https://djinni.co/jobs/rss/?",
      "requireLocation": false,
      "enabled": true
    },
    {
      "type": "rss",
      "name": "DOU Front End",
      "url": "https://jobs.dou.ua/vacancies/feeds/?category=Front%20End",
      "requireLocation": true,
      "enabled": true
    },
    {
      "type": "rss",
      "name": "DOU Node.js",
      "url": "https://jobs.dou.ua/vacancies/feeds/?category=Node.js",
      "requireLocation": true,
      "enabled": true
    },
    {
      "type": "ats",
      "name": "Ajax Systems",
      "provider": "lever",
      "board": "ajax",
      "requireLocation": true,
      "enabled": true
    },
    {
      "type": "email",
      "name": "Пошта",
      "mailbox": "INBOX",
      "lookbackDays": 2,
      "filterMode": "excludesOnly",
      "requireLocation": false,
      "enabled": false,
      "rules": [
        {
          "name": "LinkedIn",
          "fromContains": "linkedin.com",
          "linkPattern": "linkedin\\.com/(?:comm/)?jobs/view/(\\d+)",
          "urlTemplate": "https://www.linkedin.com/jobs/view/{id}/"
        },
        {
          "name": "Djinni",
          "fromContains": "djinni.co",
          "linkPattern": "djinni\\.co/jobs/(\\d+)-"
        },
        {
          "name": "Work.ua",
          "fromContains": "work.ua",
          "linkPattern": "work\\.ua/(?:[a-z]{2}/)?jobs/(\\d+)",
          "urlTemplate": "https://www.work.ua/jobs/{id}/"
        },
        {
          "name": "Robota.ua",
          "fromContains": "robota.ua",
          "linkPattern": "robota\\.ua/(?:[a-z]{2}/)?company\\d+/vacancy(\\d+)"
        },
        {
          "name": "jobs.ua",
          "fromContains": "jobs.ua",
          "linkPattern": "jobs\\.ua/job-[^/?#\"]*?-(\\d+)"
        },
        {
          "name": "DOU",
          "fromContains": "dou.ua",
          "linkPattern": "jobs\\.dou\\.ua/companies/[^/]+/vacancies/(\\d+)"
        }
      ]
    },
    {
      "type": "telegram",
      "name": "TG: Don't Panic Junior IT Jobs",
      "channel": "Job_IT_Junior",
      "requireLocation": false,
      "enabled": true
    },
    {
      "type": "telegram",
      "name": "Приклад каналу",
      "channel": "назва_публічного_каналу",
      "requireLocation": false,
      "enabled": false
    },
    {
      "type": "ats",
      "name": "uni.tech",
      "provider": "ashby",
      "board": "universe",
      "requireLocation": false,
      "enabled": true
    },
    {
      "type": "rss",
      "name": "Upstars",
      "url": "https://career.upstars.com/jobs.rss",
      "requireLocation": false,
      "enabled": true
    },
    {
      "type": "html",
      "name": "YouScan",
      "urls": ["https://youscan.peopleforce.io/careers?locale=uk"],
      "linkPattern": "youscan\\.peopleforce\\.io/careers/v/(\\d+)-",
      "requireLocation": false,
      "enabled": true
    },
    {
      "type": "ats",
      "name": "BetterMe",
