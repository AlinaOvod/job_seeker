{
  "name": "job-alert-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram-бот, що сповіщає про нові вакансії за заданими критеріями",
  "scripts": {
    "start": "tsx src/index.ts",
    "dry-run": "DRY_RUN=1 tsx src/index.ts",
    "detect": "tsx src/detect-cli.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.2"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
